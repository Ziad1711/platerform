{
  "package": "jisra-kpi-v5",
  "phase": "release-preparation-inactive",
  "branch": "p79/kpi-v5-consolidated",
  "source_commit": "34aa955",
  "created": "2026-10-21",
  "default_mode": "inactive",
  "hash_rule": "sha256 sur contenu normalise LF (CRLF -> LF), comme verify-static.mjs",
  "principles": [
    "Une etape = une transaction psql (--single-transaction, ON_ERROR_STOP=1).",
    "Aucune etape avant verification de la precedente.",
    "Installation par defaut INACTIVE : ni producteur, ni worker, ni lecteur.",
    "Chaque activation est un lot separe, garde par un parametre de session.",
    "Aucun db push, aucun rejeu des migrations B13 historiques.",
    "Aucune regle financiere modifiee.",
    "Le rollback ne rouvre jamais une permission retiree (P7.9, P8)."
  ],
  "preconditions": [
    {
      "id": "PREREQ",
      "label": "Socle metier et environnement autorise",
      "requires": [
        "cible explicitement autorisee par operation ; Production interdite en ecriture dans la preparation ; B13 uniquement sous autorisation de qualification",
        "tables stores, store_members, profiles, orders, order_items, ad_spend_daily",
        "fonctions can_view_store_finances(uuid) et order_purchase_cost(text,numeric,numeric)",
        "schema vault",
        "PostgreSQL 17.x ; pg_net et pg_cron disponibles avant les lots A et D",
        "historique migrations et objets cible compares avant execution ; collision de version => ARRET, aucun renommage implicite"
      ],
      "capture": "p79_delivery/93_preflight_capture.sql"
    },
    {
      "id": "P8.3_BASELINE",
      "label": "Socle de politiques pour P8.3",
      "requires": [
        "les 41 politiques d'ecriture et 21 de lecture capturees sur TEST doivent exister dans le socle",
        "sinon P8.3 M2/M3 cree des politiques non versionnees : etat non reproductible"
      ]
    }
  ],
