# =============================================================================
# Connexion DIRECTE (sans pooler) au projet Neon dédié à l'audit.
# Projet : weathered-sky-00057323 (org-weathered-shadow-36459160)
#
# Copier HORS du dépôt (ex. ~/jisra-audit/env.local), renseigner, puis :
#   source ~/jisra-audit/env.local
# Ne JAMAIS committer ce fichier renseigné (il contient le mot de passe).
# =============================================================================

# --- Endpoint DIRECT (pas de "-pooler" dans l'hôte) --------------------------
export PGHOST='<endpoint-id>.<region>.aws.neon.tech'
export PGPORT='5432'
export PGDATABASE='<database>'          # p. ex. neondb, ou base dédiée à l'audit
export PGUSER='<role_proprietaire>'     # rôle membre de neon_superuser
export PGPASSWORD='<mot_de_passe>'      # fourni par la console Neon

# --- TLS vérifié -------------------------------------------------------------
# verify-full exige un bundle CA côté client : Neon utilise ISRG Root X1
# (Let's Encrypt). Windows ne fournit pas de bundle lisible par libpq.
export PGSSLMODE='verify-full'
export PGSSLROOTCERT='<chemin>/isrgrootx1.pem'
export PGCONNECT_TIMEOUT='15'

# --- Gardes de l'audit -------------------------------------------------------
export AUDIT_DB="$PGDATABASE"
export AUDIT_ENV='neon-audit'
export AUDIT_HOST="$PGHOST"

# --- URL dérivée (utilisée par run_audit.sh) ---------------------------------
export AUDIT_URL="postgresql://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}?sslmode=${PGSSLMODE}&sslrootcert=${PGSSLROOTCERT}"

# Rappel : ce fichier renseigné reste hors dépôt et n'est jamais commité.
