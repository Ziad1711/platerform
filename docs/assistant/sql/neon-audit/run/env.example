# =============================================================================
# Variables d'environnement de l'audit (aucun secret dans le dépôt)
# Copier hors dépôt, renseigner, puis :  source ./env.local
# Ne JAMAIS committer env.local.
# =============================================================================

# URL complète de la base JETABLE (projet Neon dédié à cet audit).
# sslmode=verify-full + sslrootcert si le bundle CA n'est pas dans le store.
export AUDIT_URL='postgresql://<user>:<password>@<host>/<db>?sslmode=verify-full'

# Nom exact de la base : sert de garde (le prévol refuse tout autre nom).
export AUDIT_DB='jisra_assistant_audit_20261029'

# Marqueur d'environnement vérifié par le prévol.
export AUDIT_ENV='neon-audit'

# Optionnel : chemin du bundle CA si nécessaire.
# export PGSSLROOTCERT='/chemin/neon-ca.pem'

# Rappel : ce fichier et AUDIT_URL ne doivent jamais être commités.
